---
import { Picture } from 'astro:assets';
import heroImage from '../assets/brand/hero.jpg';
import Logo from '../assets/brand/logo.svg';
import Icon from './Icon.astro';
import { DOWNLOADS, SITE } from '../config/site.ts';
import { cardapio } from '../data/menu.ts';
import { countItems } from '../lib/menu.ts';
import { SIZES, widthsFor } from '../lib/images.ts';

const total = countItems(cardapio);
---

<header class="hero" id="topo">
  <div class="hero-media" aria-hidden="true">
    <Picture
      src={heroImage}
      alt=""
      formats={['avif']}
      fallbackFormat="webp"
      widths={widthsFor(heroImage, [640, 960, 1280, 1920, 2560])}
      sizes={SIZES.hero}
      loading="eager"
      fetchpriority="high"
      class="hero-img"
    />
  </div>

  <div class="hero-content container">
    <p class="hero-table" data-table-welcome hidden>
      <Icon name="utensils" size={16} />{' '}
      <span>
        Você está na <strong data-table-number>mesa</strong>
      </span>
    </p>
    <Logo class="hero-logo" width={52} height={52} aria-hidden="true" />
    <p class="hero-kicker">Cardápio digital</p>
    <h1 class="hero-title">{SITE.name}</h1>
    <p class="hero-tagline">{SITE.tagline}</p>

    <ul class="hero-facts" role="list">
      <li>
        <Icon name="clock" size={15} /> Terça a domingo
      </li>
      <li>
        <Icon name="map-pin" size={15} /> {SITE.address.city} · {SITE.address.region}
      </li>
      <li>
        <Icon name="utensils" size={15} /> {total} itens
      </li>
    </ul>

    <div class="hero-actions">
      <a class="btn btn-primary" href="#cardapio">
        <Icon name="chevron-down" /> Ver cardápio
      </a>
      <a class="btn btn-ghost" href={DOWNLOADS.menuPdf.path} download={DOWNLOADS.menuPdf.filename}>
        <Icon name="file-down" /> Baixar cardápio (PDF)
      </a>
    </div>
  </div>

  <svg class="hero-wave" viewBox="0 0 1440 90" preserveAspectRatio="none" aria-hidden="true">
    <path d="M0 48c240 44 480-40 720-8s480 52 720 8v42H0z"></path>
  </svg>
</header>

<style>
  .hero {
    position: relative;
    isolation: isolate;
    display: grid;
    align-items: end;
    min-height: min(82svh, 44rem);
    padding: calc(2.5rem + env(safe-area-inset-top)) 0 5rem;
    color: #fff;
    background: var(--brand-900);
    overflow: hidden;
  }
  .hero-media {
    position: absolute;
    inset: 0;
    z-index: -1;
  }
  .hero-media :global(picture),
  .hero-media :global(img) {
    width: 100%;
    height: 100%;
  }
  .hero-media :global(img) {
    object-fit: cover;
    object-position: 58% 40%;
  }
  .hero-media::after {
    content: '';
    position: absolute;
    inset: 0;
    background:
      linear-gradient(180deg, rgb(11 33 26 / 0.25) 0%, rgb(11 33 26 / 0.45) 35%, rgb(11 33 26 / 0.95) 100%),
      radial-gradient(120% 70% at 50% 100%, rgb(234 125 23 / 0.1), transparent 60%);
  }

  .hero-content {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
  }
  .hero-table {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    margin-bottom: 1.1rem;
    padding: 0.3rem 0.8rem;
    border-radius: var(--radius-pill);
    background: rgb(255 255 255 / 0.1);
    box-shadow: inset 0 0 0 1px rgb(255 255 255 / 0.28);
    color: rgb(255 255 255 / 0.9);
    font-size: 0.82rem;
    font-weight: 500;
  }
  .hero-table strong {
    color: var(--accent-300);
    font-weight: 600;
  }
  .hero-logo {
    width: 3.25rem;
    height: 3.25rem;
  }
  .hero-kicker {
    margin-top: 1.25rem;
    color: var(--accent-300);
    font-size: 0.7rem;
    font-weight: 600;
    letter-spacing: 0.34em;
    text-transform: uppercase;
  }
  .hero-title {
    margin-top: 0.55rem;
    font-family: var(--font-display);
    font-size: var(--step-4);
    font-weight: 560;
    line-height: 1;
    letter-spacing: -0.02em;
  }
  .hero-tagline {
    max-width: 32ch;
    margin-top: 0.8rem;
    color: rgb(255 255 255 / 0.8);
    font-size: var(--step-1);
    font-weight: 400;
  }
  .hero-facts {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 0.4rem 1.1rem;
    margin-top: 1.2rem;
    color: rgb(255 255 255 / 0.72);
    font-size: 0.85rem;
    font-weight: 450;
  }
  .hero-facts li {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
  }
  .hero-facts :global(svg) {
    color: var(--accent-300);
  }
  .hero-actions {
    display: grid;
    gap: 0.6rem;
    width: 100%;
    max-width: 20rem;
    margin-top: 1.75rem;
  }

  .hero-wave {
    position: absolute;
    left: 0;
    right: 0;
    bottom: -1px;
    width: 100%;
    height: clamp(2.2rem, 5vw, 4.5rem);
    fill: var(--cream-100);
  }

  @media (min-width: 40rem) {
    .hero-actions {
      display: flex;
      flex-wrap: wrap;
      justify-content: center;
      max-width: none;
    }
  }

  @media (min-width: 64rem) {
    .hero {
      align-items: center;
      min-height: min(86vh, 50rem);
      padding-bottom: 6.5rem;
    }
    /* Foto à direita do texto, fundindo com o verde da marca. */
    /* Termina em --brand-950 exatamente onde a foto começa (30%): sem emenda. */
    .hero {
      background: linear-gradient(90deg, var(--brand-800) 0%, var(--brand-950) 30%);
    }
    .hero-media {
      left: 30%;
    }
    .hero-media::after {
      background:
        linear-gradient(90deg, var(--brand-950) 0%, rgb(11 33 26 / 0.7) 18%, rgb(11 33 26 / 0) 45%),
        linear-gradient(0deg, rgb(11 33 26 / 0.6) 0%, transparent 30%),
        linear-gradient(180deg, rgb(11 33 26 / 0.45) 0%, transparent 25%);
    }
    .hero-media :global(img) {
      object-position: 55% 60%;
    }
    .hero-content {
      align-items: flex-start;
      text-align: left;
    }
    .hero-facts,
    .hero-actions {
      justify-content: flex-start;
    }
  }

  /* Celular deitado: hero mais baixo para o cardápio aparecer logo. */
  @media (orientation: landscape) and (max-height: 32rem) {
    .hero {
      min-height: auto;
      padding-top: calc(1.5rem + env(safe-area-inset-top));
    }
    .hero-logo {
      display: none;
    }
  }
</style>
