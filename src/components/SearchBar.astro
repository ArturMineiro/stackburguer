---
import Icon from './Icon.astro';
---

<div class="search" role="search" data-search-root>
  <label class="visually-hidden" for="busca">
    Buscar no cardápio
  </label>
  <div class="search-field">
    <Icon name="search" size={20} />
    <input
      id="busca"
      type="search"
      placeholder="Buscar: bacon, cheddar, vegetariano…"
      autocomplete="off"
      autocapitalize="off"
      spellcheck="false"
      enterkeyhint="search"
      data-search-input
    />
    <button type="button" class="search-clear" aria-label="Limpar busca" data-search-clear hidden>
      <Icon name="x" size={18} />
    </button>
  </div>
  <p class="search-status" role="status" aria-live="polite" data-search-status></p>
</div>

<style>
  .search {
    width: 100%;
    max-width: 42rem;
    margin-inline: auto;
  }
  .search-field {
    position: relative;
    display: flex;
    align-items: center;
    gap: 0.6rem;
    padding: 0 0.5rem 0 1.05rem;
    border-radius: var(--radius-pill);
    background: #fff;
    color: var(--ink-500);
    box-shadow:
      var(--shadow-sm),
      inset 0 0 0 1px var(--cream-300);
    transition: box-shadow 0.2s;
  }
  .search-field:focus-within {
    box-shadow:
      var(--shadow),
      inset 0 0 0 2px var(--accent-500);
  }
  input {
    flex: 1;
    min-width: 0;
    height: 3.25rem;
    border: 0;
    background: transparent;
    color: var(--ink-900);
    font-size: 1rem; /* ≥16px evita zoom automático no iOS */
    outline: none;
  }
  input::placeholder {
    color: var(--ink-500);
    opacity: 1;
  }
  input::-webkit-search-cancel-button {
    appearance: none;
  }
  .search-clear {
    display: grid;
    place-items: center;
    width: 2.5rem;
    height: 2.5rem;
    border-radius: 50%;
    color: var(--ink-700);
    background: var(--cream-200);
  }
  .search-clear:hover {
    background: var(--cream-300);
  }
  .search-status {
    min-height: 1.5em;
    margin-top: 0.55rem;
    color: var(--ink-500);
    font-size: var(--step--1);
    text-align: center;
  }
</style>
