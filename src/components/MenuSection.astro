---
import Icon from './Icon.astro';
import MenuCard from './MenuCard.astro';
import { formatPrice, plural } from '../lib/format.ts';
import type { Categoria } from '../lib/menu.ts';
import { searchableText } from '../lib/search.ts';

interface Props {
  categoria: Categoria;
  /** Posição da categoria (1, 2, 3…), exibida como "01". */
  index: number;
}

const { categoria, index } = Astro.props;
const titleId = `${categoria.id}-titulo`;
---

<section class="menu-section" id={categoria.id} aria-labelledby={titleId} data-section={categoria.id}>
  <header class="section-head">
    <p class="section-kicker kicker">
      <Icon name={categoria.icone} size={14} />
      <span>{String(index).padStart(2, '0')}</span>
      <span class="section-count">· {plural(categoria.itens.length, 'item', 'itens')}</span>
    </p>
    <h2 class="section-title" id={titleId} tabindex="-1">
      {categoria.titulo}
    </h2>
    {categoria.subtitulo && <p class="section-sub">{categoria.subtitulo}</p>}
  </header>

  <ul class="menu-grid" role="list">
    {categoria.itens.map((item) => (
      <li
        class="menu-item"
        id={`item-${item.id}`}
        data-menu-item={item.id}
        data-search={searchableText(item, categoria)}
      >
        <MenuCard item={item} />
      </li>
    ))}
  </ul>

  {categoria.extras.length > 0 && (
    <div class="extras" data-extras>
      {categoria.extras.map((extra) => (
        <div class="extra">
          <h3 class="extra-title">{extra.titulo}</h3>
          {extra.descricao && <p class="extra-desc">{extra.descricao}</p>}
          <ul class="extra-list" role="list">
            {extra.itens.map((adicional) => (
              <li>
                <span class="extra-name">{adicional.nome}</span>
                <span class="extra-dots" aria-hidden="true" />
                <span class="price">+ {formatPrice(adicional.preco)}</span>
              </li>
            ))}
          </ul>
        </div>
      ))}
    </div>
  )}
</section>

<style>
  .menu-section {
    padding-top: clamp(3rem, 7vw, 4.75rem);
  }
  .menu-section:first-of-type {
    padding-top: clamp(1.5rem, 4vw, 2.5rem);
  }

  .section-head {
    margin-bottom: 1.5rem;
    padding-bottom: 1rem;
    border-bottom: 1px solid var(--line);
  }
  .section-kicker {
    display: flex;
    align-items: center;
    gap: 0.4rem;
  }
  .section-count {
    color: var(--ink-500);
    letter-spacing: 0.12em;
  }
  .section-title {
    margin-top: 0.45rem;
    font-family: var(--font-display);
    font-size: var(--step-3);
    font-weight: 560;
    line-height: 1.05;
    letter-spacing: -0.02em;
    color: var(--brand-800);
  }
  .section-title:focus {
    outline: none;
  }
  .section-sub {
    margin-top: 0.4rem;
    color: var(--ink-500);
    font-size: var(--step--1);
  }

  .menu-grid {
    display: grid;
    gap: 0.75rem;
  }

  /* Adicionais e combos: painel claro, como no cardápio impresso. */
  .extras {
    display: grid;
    gap: 0.75rem;
    margin-top: 1.25rem;
  }
  .extra {
    padding: 1.15rem 1.2rem 1rem;
    border-radius: var(--radius-lg);
    background: var(--cream-50);
    box-shadow: inset 0 0 0 1px var(--line);
  }
  .extra-title {
    font-family: var(--font-display);
    font-size: 1.3rem;
    font-weight: 560;
    letter-spacing: -0.01em;
    color: var(--brand-800);
  }
  .extra-desc {
    margin-top: 0.15rem;
    color: var(--ink-500);
    font-size: 0.88rem;
  }
  .extra-list {
    display: grid;
    gap: 0 1.75rem;
    margin-top: 0.6rem;
  }
  .extra-list li {
    display: flex;
    align-items: baseline;
    gap: 0.5rem;
    padding: 0.32rem 0;
    font-size: 0.93rem;
    color: var(--ink-700);
  }
  .extra-dots {
    flex: 1;
    min-width: 1rem;
    border-bottom: 1px dotted var(--line-strong);
    transform: translateY(-0.25rem);
  }
  .extra-list .price {
    color: var(--brand-800);
  }

  /* Durante a busca escondemos os blocos de adicionais. */
  :global(.is-searching) .extras {
    display: none;
  }

  @media (min-width: 48rem) {
    .menu-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 0.9rem 1.1rem;
    }
    .extras {
      grid-template-columns: repeat(auto-fit, minmax(min(100%, 20rem), 1fr));
    }
    .extra-list {
      grid-template-columns: repeat(auto-fill, minmax(13rem, 1fr));
    }
  }
</style>
