---
import { Picture } from 'astro:assets';
import Badges from './Badges.astro';
import Icon from './Icon.astro';
import { photoOf } from '../data/menu.ts';
import { basePrice, hasVariations, type Item } from '../lib/menu.ts';
import { formatPrice } from '../lib/format.ts';
import { SIZES, widthsFor } from '../lib/images.ts';

interface Props {
  item: Item;
}

const { item } = Astro.props;
const photo = photoOf(item);
---

<article class="card">
  <div class="card-media">
    <Picture
      src={photo}
      alt=""
      formats={['avif']}
      fallbackFormat="webp"
      widths={widthsFor(photo, [160, 240, 320])}
      sizes={SIZES.card}
      loading="lazy"
      decoding="async"
    />
  </div>

  <div class="card-body">
    <div class="card-top">
      <h3 class="card-title">
        <button type="button" class="card-open" data-open-item={item.id} aria-haspopup="dialog">
          {item.nome}
        </button>
      </h3>
      <p class="card-price">
        {hasVariations(item) && <span class="card-from">a partir de</span>}
        <span class="price">{formatPrice(basePrice(item))}</span>
      </p>
    </div>
    <p class="card-desc">{item.descricao}</p>
    <div class="card-foot">
      <Badges badges={item.selos.slice(0, 2)} class="card-badges" />
      <span class="card-more" aria-hidden="true">
        <span class="card-more-label">Detalhes</span>
        <Icon name="chevron-right" size={14} />
      </span>
    </div>
  </div>
</article>

<style>
  /* Item de cardápio compacto: miniatura à esquerda, nome e preço na mesma linha. */
  .card {
    position: relative;
    display: grid;
    grid-template-columns: 5.25rem minmax(0, 1fr);
    align-items: start;
    gap: 0.9rem;
    height: 100%;
    padding: 0.75rem;
    border-radius: var(--radius-lg);
    background: #fff;
    box-shadow: inset 0 0 0 1px var(--line);
    transition:
      box-shadow 0.2s,
      transform 0.25s var(--ease-out);
  }
  .card:has(.card-open:focus-visible) {
    outline: 2px solid var(--accent-500);
    outline-offset: 2px;
  }

  .card-media {
    aspect-ratio: 1;
    overflow: hidden;
    border-radius: var(--radius);
    background: var(--cream-200);
  }
  .card-media :global(picture),
  .card-media :global(img) {
    width: 100%;
    height: 100%;
  }
  .card-media :global(img) {
    object-fit: cover;
    transition: transform 0.5s var(--ease-out);
  }

  .card-body {
    display: flex;
    flex-direction: column;
    gap: 0.3rem;
    min-width: 0;
    height: 100%;
  }
  .card-top {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 0.75rem;
  }
  .card-title {
    font-size: 1rem;
    font-weight: 600;
    line-height: 1.3;
    letter-spacing: -0.005em;
    color: var(--ink-900);
  }
  .card-open {
    text-align: left;
    font-weight: inherit;
  }
  .card-open::after {
    content: '';
    position: absolute;
    inset: 0;
    border-radius: inherit;
  }
  .card-open:focus-visible {
    outline: none;
  }
  .card-price {
    display: flex;
    flex: none;
    flex-direction: column;
    align-items: flex-end;
    line-height: 1.15;
  }
  .card-from {
    color: var(--ink-500);
    font-size: 0.64rem;
    letter-spacing: 0.02em;
  }
  .card-price .price {
    color: var(--brand-800);
    font-size: 0.97rem;
  }
  .card-desc {
    display: -webkit-box;
    -webkit-box-orient: vertical;
    -webkit-line-clamp: 2;
    line-clamp: 2;
    overflow: hidden;
    color: var(--ink-500);
    font-size: 0.875rem;
    line-height: 1.45;
  }
  .card-foot {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    margin-top: auto;
    padding-top: 0.15rem;
  }
  .card-more {
    display: inline-flex;
    align-items: center;
    gap: 0.1rem;
    margin-left: auto;
    color: var(--brand-600);
    font-size: 0.8rem;
    font-weight: 500;
  }

  @media (hover: hover) {
    .card:hover {
      box-shadow:
        inset 0 0 0 1px rgb(234 125 23 / 0.45),
        var(--shadow);
      transform: translateY(-1px);
    }
    .card:hover .card-media :global(img) {
      transform: scale(1.04);
    }
  }

  /* No celular, um selo por card para não engordar a linha (todos aparecem no detalhe). */
  @media (max-width: 47.99rem) {
    .card-foot :global(.badge:nth-child(n + 2)) {
      display: none;
    }
  }

  /* Celulares muito estreitos (ex.: Galaxy Fold fechado). */
  @media (max-width: 22rem) {
    .card {
      grid-template-columns: 4.25rem minmax(0, 1fr);
      gap: 0.7rem;
      padding: 0.65rem;
    }
    .card-more-label {
      display: none;
    }
  }

  @media (min-width: 48rem) {
    .card {
      grid-template-columns: 6.5rem minmax(0, 1fr);
      gap: 1.1rem;
      padding: 0.85rem;
    }
    .card-title {
      font-size: 1.04rem;
    }
  }
</style>
