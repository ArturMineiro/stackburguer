---
import { Picture } from 'astro:assets';
import Badges from './Badges.astro';
import Icon from './Icon.astro';
import { photoOf } from '../data/menu.ts';
import { basePrice, hasVariations, type Item } from '../lib/menu.ts';
import { formatPrice } from '../lib/format.ts';
import { SIZES, widthsFor } from '../lib/images.ts';

interface Props {
  item: Item;
}

const { item } = Astro.props;
const photo = photoOf(item);
---

<article class="card">
  <div class="card-media">
    <Picture
      src={photo}
      alt=""
      formats={['avif', 'webp']}
      widths={widthsFor(photo, [240, 400, 640])}
      sizes={SIZES.card}
      loading="lazy"
      decoding="async"
    />
  </div>

  <div class="card-body">
    <h3 class="card-title">
      <button type="button" class="card-open" data-open-item={item.id} aria-haspopup="dialog">
        {item.nome}
      </button>
    </h3>
    <p class="card-desc">{item.descricao}</p>
    <Badges badges={item.selos} class="card-badges" />
    <div class="card-foot">
      <p class="card-price">
        {hasVariations(item) && <span class="card-from">a partir de</span>}
        <span class="price">{formatPrice(basePrice(item))}</span>
      </p>
      <span class="card-more" aria-hidden="true">
        <span class="card-more-label">Detalhes</span>
        <Icon name="chevron-right" size={18} />
      </span>
    </div>
  </div>
</article>

<style>
  .card {
    position: relative;
    display: grid;
    grid-template-columns: minmax(0, 1fr) 7.5rem;
    grid-template-areas: 'body media';
    gap: 0.9rem;
    height: 100%;
    padding: 0.9rem;
    border-radius: var(--radius-lg);
    background: #fff;
    box-shadow:
      var(--shadow-sm),
      inset 0 0 0 1px rgb(234 223 204 / 0.7);
    transition:
      transform 0.25s var(--ease-out),
      box-shadow 0.25s var(--ease-out);
  }
  .card:has(.card-open:focus-visible) {
    outline: 3px solid var(--accent-500);
    outline-offset: 3px;
  }

  .card-media {
    grid-area: media;
    align-self: start;
    aspect-ratio: 1;
    overflow: hidden;
    border-radius: var(--radius);
    background: var(--cream-200);
  }
  .card-media :global(picture),
  .card-media :global(img) {
    width: 100%;
    height: 100%;
  }
  .card-media :global(img) {
    object-fit: cover;
    transition: transform 0.6s var(--ease-out);
  }

  .card-body {
    grid-area: body;
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
    min-width: 0;
  }
  .card-title {
    font-size: 1.05rem;
    font-weight: 800;
    line-height: 1.25;
    color: var(--brand-800);
  }
  .card-open {
    text-align: left;
    font-weight: inherit;
  }
  .card-open::after {
    content: '';
    position: absolute;
    inset: 0;
    border-radius: inherit;
  }
  .card-open:focus-visible {
    outline: none;
  }
  .card-desc {
    display: -webkit-box;
    -webkit-box-orient: vertical;
    -webkit-line-clamp: 2;
    line-clamp: 2;
    overflow: hidden;
    color: var(--ink-500);
    font-size: 0.92rem;
    line-height: 1.45;
  }
  .card-foot {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: 0.5rem;
    margin-top: auto;
    padding-top: 0.35rem;
  }
  .card-price {
    display: flex;
    flex-direction: column;
    line-height: 1.15;
  }
  .card-from {
    color: var(--ink-500);
    font-size: 0.72rem;
    font-weight: 600;
  }
  .card-price .price {
    color: var(--accent-700);
    font-size: 1.12rem;
  }
  .card-more {
    display: inline-flex;
    align-items: center;
    gap: 0.15rem;
    color: var(--brand-600);
    font-size: 0.85rem;
    font-weight: 750;
  }
  /* No celular mostramos só a seta (o card inteiro é clicável). */
  .card-more-label {
    display: none;
  }

  @media (hover: hover) {
    .card:hover {
      transform: translateY(-3px);
      box-shadow:
        var(--shadow),
        inset 0 0 0 1px rgb(234 125 23 / 0.35);
    }
    .card:hover .card-media :global(img) {
      transform: scale(1.05);
    }
  }

  /* Celulares muito estreitos (ex.: Galaxy Fold fechado). */
  @media (max-width: 22rem) {
    .card {
      grid-template-columns: minmax(0, 1fr) 5.75rem;
      gap: 0.7rem;
      padding: 0.75rem;
    }
  }

  /* A partir de tablets: card vertical com foto em destaque. */
  @media (min-width: 40rem) {
    .card {
      grid-template-columns: 1fr;
      grid-template-areas: 'media' 'body';
      grid-template-rows: auto 1fr;
      gap: 0;
      padding: 0;
      overflow: hidden;
    }
    .card-media {
      aspect-ratio: 4 / 3;
      border-radius: 0;
    }
    .card-body {
      padding: 1rem 1.1rem 1.1rem;
    }
    .card-title {
      font-size: 1.15rem;
    }
    .card-more-label {
      display: inline;
    }
  }
</style>
