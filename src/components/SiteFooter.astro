---
import Logo from '../assets/brand/logo.svg';
import Icon from './Icon.astro';
import QrCode from './QrCode.astro';
import { DOWNLOADS, SITE, tableUrl } from '../config/site.ts';
import { credits } from '../data/credits.ts';

const { address } = SITE;
const fullAddress = `${address.street}, ${address.city} - ${address.region}, ${address.postalCode}`;
const mapsUrl = `https://www.google.com/maps/search/?api=1&query=${encodeURIComponent(fullAddress)}`;
const year = new Date().getFullYear();
---

<footer class="footer">
  <div class="container">
    <section class="cta" aria-labelledby="cta-titulo">
      <div class="cta-qr">
        <QrCode url={tableUrl()} title="QR Code do cardápio digital" />
      </div>
      <div class="cta-text">
        <p class="cta-kicker">Cardápio digital</p>
        <h2 class="cta-title" id="cta-titulo">
          Leve o cardápio com você
        </h2>
        <p class="cta-desc">
          <span class="only-desktop">Aponte a câmera do celular para o código ou baixe </span>
          <span class="only-mobile">Baixe </span>a versão em PDF para guardar, compartilhar ou imprimir.
        </p>
      </div>
      <div class="cta-actions">
        <a class="btn btn-primary" href={DOWNLOADS.menuPdf.path} download={DOWNLOADS.menuPdf.filename}>
          <Icon name="file-down" /> Baixar cardápio (PDF)
        </a>
        <a class="btn btn-ghost" href={DOWNLOADS.qrKitPdf.path} download={DOWNLOADS.qrKitPdf.filename}>
          <Icon name="printer" /> QR Codes das mesas
        </a>
      </div>
    </section>

    <div class="info">
      <div class="brand">
        <div class="brand-row">
          <Logo width={48} height={48} aria-hidden="true" />
          <p class="brand-name">{SITE.name}</p>
        </div>
        <p class="brand-tagline">{SITE.tagline}</p>
        <ul class="social" role="list">
          {SITE.social.map((rede) => (
            <li>
              <a
                href={rede.url}
                target="_blank"
                rel="noopener noreferrer"
                aria-label={`${rede.name} (abre em nova aba)`}
              >
                <Icon name={rede.icon} size={20} />
              </a>
            </li>
          ))}
        </ul>
      </div>

      <div class="col">
        <h2 class="col-title">
          <Icon name="clock" size={18} /> Horário
        </h2>
        <dl class="hours">
          {SITE.hours.map((horario) => (
            <div>
              <dt>{horario.label}</dt>
              <dd>{horario.time}</dd>
            </div>
          ))}
        </dl>
      </div>

      <div class="col">
        <h2 class="col-title">
          <Icon name="map-pin" size={18} /> Onde estamos
        </h2>
        <address>
          {address.street}
          <br />
          {address.city} – {address.region}
          <br />
          CEP {address.postalCode}
        </address>
        <a class="map-link" href={mapsUrl} target="_blank" rel="noopener noreferrer">
          Ver no mapa <Icon name="arrow-right" size={16} />
        </a>
      </div>
    </div>

    <div class="bottom">
      <div>
        <p>
          © <span data-year>{year}</span> {SITE.name} · CNPJ {SITE.cnpj}
        </p>
        <p class="notice">{SITE.priceNotice}</p>
      </div>
      <p class="credit">
        Desenvolvido por{' '}
        <a href={SITE.credit.url} target="_blank" rel="noopener">
          {SITE.credit.name}
        </a>
        {credits.length > 0 && (
          <>
            <span aria-hidden="true"> · </span>
            <a href="/creditos/">Créditos das fotos</a>
          </>
        )}
      </p>
    </div>
  </div>
</footer>

<style>
  .footer {
    margin-top: clamp(3.5rem, 9vw, 6rem);
    padding: 0 0 calc(6rem + env(safe-area-inset-bottom)); /* espaço para o botão "voltar ao topo" */
    color: rgb(255 255 255 / 0.78);
    background: linear-gradient(180deg, var(--brand-800), var(--brand-950) 70%);
  }

  /* ---------- Faixa de destaque ---------- */
  .cta {
    position: relative;
    display: grid;
    gap: 1.25rem;
    padding: 1.6rem 1.35rem;
    border-radius: var(--radius-xl);
    background:
      radial-gradient(120% 140% at 100% 0%, rgb(234 125 23 / 0.32), transparent 55%),
      linear-gradient(135deg, var(--brand-600), var(--brand-800));
    box-shadow:
      var(--shadow-lg),
      inset 0 0 0 1px rgb(255 255 255 / 0.1);
    transform: translateY(-2.25rem);
  }
  .cta-qr {
    display: none;
  }
  .cta-kicker {
    color: var(--accent-300);
    font-size: 0.75rem;
    font-weight: 800;
    letter-spacing: 0.2em;
    text-transform: uppercase;
  }
  .cta-title {
    margin-top: 0.2rem;
    color: #fff;
    font-family: var(--font-display);
    font-size: clamp(2rem, 1.6rem + 1.8vw, 2.6rem);
    font-weight: 400;
    line-height: 1;
    letter-spacing: 0.02em;
  }
  .cta-desc {
    margin-top: 0.5rem;
    color: rgb(255 255 255 / 0.82);
    font-size: 0.97rem;
  }
  .only-desktop {
    display: none;
  }
  .cta-actions {
    display: grid;
    gap: 0.65rem;
  }

  /* ---------- Informações ---------- */
  .info {
    display: grid;
    gap: 2rem;
    padding: 0.5rem 0 2.25rem;
  }
  .brand-row {
    display: flex;
    align-items: center;
    gap: 0.75rem;
  }
  .brand-name {
    color: #fff;
    font-family: var(--font-display);
    font-size: 2rem;
    line-height: 1;
    letter-spacing: 0.03em;
  }
  .brand-tagline {
    margin-top: 0.6rem;
    max-width: 30ch;
  }
  .social {
    display: flex;
    gap: 0.6rem;
    margin-top: 1rem;
  }
  .social a {
    display: grid;
    place-items: center;
    width: 2.9rem;
    height: 2.9rem;
    border-radius: 50%;
    color: #fff;
    background: rgb(255 255 255 / 0.08);
    box-shadow: inset 0 0 0 1px rgb(255 255 255 / 0.14);
    transition:
      background-color 0.2s,
      color 0.2s,
      transform 0.2s var(--ease-out);
  }
  .social a:hover {
    background: var(--accent-600);
    color: var(--ink-900);
    transform: translateY(-2px);
  }

  .col-title {
    display: flex;
    align-items: center;
    gap: 0.45rem;
    margin-bottom: 0.7rem;
    color: var(--accent-300);
    font-size: 0.78rem;
    font-weight: 800;
    letter-spacing: 0.16em;
    text-transform: uppercase;
  }
  .hours div {
    display: flex;
    justify-content: space-between;
    gap: 1rem;
    padding: 0.5rem 0;
    border-bottom: 1px solid rgb(255 255 255 / 0.09);
  }
  .hours div:last-child {
    border-bottom: 0;
  }
  .hours dd {
    color: #fff;
    font-weight: 700;
    white-space: nowrap;
  }
  address {
    font-style: normal;
    line-height: 1.7;
  }
  .map-link {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    min-height: 2.75rem;
    color: var(--accent-300);
    font-weight: 700;
    text-decoration: none;
  }
  .map-link:hover {
    color: #fff;
  }

  /* ---------- Barra final ---------- */
  .bottom {
    display: grid;
    gap: 0.75rem;
    padding-top: 1.4rem;
    border-top: 1px solid rgb(255 255 255 / 0.12);
    font-size: 0.85rem;
    text-align: center;
  }
  .notice {
    margin-top: 0.2rem;
    color: rgb(255 255 255 / 0.55);
    font-size: 0.8rem;
  }
  .credit a {
    color: var(--accent-300);
    font-weight: 700;
    text-decoration: none;
  }
  .credit a:hover {
    text-decoration: underline;
  }

  /* Telas mínimas (ex.: Galaxy Fold fechado). */
  @media (max-width: 22rem) {
    .cta {
      padding: 1.3rem 1rem;
    }
    .cta-actions .btn {
      padding-inline: 0.9rem;
      font-size: 0.93rem;
    }
  }

  @media (min-width: 40rem) {
    .cta-actions {
      display: flex;
      flex-wrap: wrap;
    }
    .info {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
    .brand {
      grid-column: 1 / -1;
    }
  }

  @media (min-width: 64rem) {
    .footer {
      padding-bottom: calc(2rem + env(safe-area-inset-bottom));
    }
    .cta {
      grid-template-columns: auto minmax(0, 1fr) auto;
      align-items: center;
      gap: 2rem;
      padding: 1.75rem 2rem;
    }
    .cta-qr {
      display: block;
      width: 7.5rem;
      padding: 0.55rem;
      border-radius: var(--radius);
      background: #fff;
      box-shadow: 0 0 0 4px var(--accent-500);
    }
    .only-desktop {
      display: inline;
    }
    .only-mobile {
      display: none;
    }
    .cta-actions {
      flex-direction: column;
      align-items: stretch;
    }
    .info {
      grid-template-columns: 1.3fr 1fr 1fr;
      gap: 3rem;
    }
    .brand {
      grid-column: auto;
    }
    .bottom {
      grid-template-columns: 1fr auto;
      align-items: end;
      text-align: left;
    }
  }
</style>
