---
import { Picture } from 'astro:assets';
import Badges from './Badges.astro';
import Icon from './Icon.astro';
import { photoOf } from '../data/menu.ts';
import { hasVariations, type Categoria, type Item } from '../lib/menu.ts';
import { formatPrice } from '../lib/format.ts';
import { SIZES, widthsFor } from '../lib/images.ts';

interface Props {
  item: Item;
  categoria: Categoria;
}

const { item, categoria } = Astro.props;
const photo = photoOf(item);
const titleId = `dlg-${item.id}-titulo`;
---

<dialog class="sheet" id={`dlg-${item.id}`} aria-labelledby={titleId} data-item-dialog={item.id}>
  <div class="sheet-card">
    <div class="sheet-media">
      <Picture
        src={photo}
        alt={`Foto ilustrativa: ${item.nome}`}
        formats={['avif']}
        fallbackFormat="webp"
        widths={widthsFor(photo, [480, 800, 1200])}
        sizes={SIZES.dialog}
        loading="lazy"
        decoding="async"
      />
    </div>

    <div class="sheet-main">
      <div class="sheet-body">
        <p class="sheet-kicker">
          <Icon name={categoria.icone} size={16} /> {categoria.titulo}
        </p>
        <h2 class="sheet-title" id={titleId}>
          {item.nome}
        </h2>
        <Badges badges={item.selos} />
        <p class="sheet-lead">{item.descricao}</p>
        {item.detalhes && <p class="sheet-text">{item.detalhes}</p>}

        <section class="sheet-block">
          <h3 class="sheet-heading">{hasVariations(item) ? 'Opções e preços' : 'Preço'}</h3>
          <ul class="price-list" role="list">
            {item.opcoes.map((opcao) => (
              <li>
                <span class="price-name">{opcao.titulo}</span>
                <span class="price-dots" aria-hidden="true" />
                <span class="price">{formatPrice(opcao.preco)}</span>
              </li>
            ))}
          </ul>
        </section>

        {item.ingredientes.length > 0 && (
          <section class="sheet-block">
            <h3 class="sheet-heading">Ingredientes</h3>
            <ul class="ingredients" role="list">
              {item.ingredientes.map((ingrediente) => (
                <li>{ingrediente}</li>
              ))}
            </ul>
          </section>
        )}

        {categoria.extras.map((extra) => (
          <section class="sheet-block">
            <h3 class="sheet-heading">{extra.titulo}</h3>
            {extra.descricao && <p class="sheet-small">{extra.descricao}</p>}
            <ul class="price-list price-list--compact" role="list">
              {extra.itens.map((adicional) => (
                <li>
                  <span class="price-name">{adicional.nome}</span>
                  <span class="price-dots" aria-hidden="true" />
                  <span class="price">+ {formatPrice(adicional.preco)}</span>
                </li>
              ))}
            </ul>
          </section>
        ))}

        {item.nota && (
          <p class="sheet-note">
            <Icon name="info" size={16} /> {item.nota}
          </p>
        )}
      </div>

      <div class="sheet-actions">
        <button type="button" class="btn btn-dark" data-close-dialog>
          Voltar ao cardápio
        </button>
      </div>
    </div>

    <button type="button" class="sheet-close" data-close-dialog aria-label="Fechar detalhes">
      <Icon name="x" size={22} />
    </button>
  </div>
</dialog>

<style>
  .sheet {
    width: 100%;
    max-width: 100%;
    max-height: 100%;
    margin: auto auto 0;
    padding: 0;
    border: 0;
    background: transparent;
    color: inherit;
    overflow: visible;
  }
  .sheet::backdrop {
    background: rgb(8 20 15 / 0.62);
  }
  .sheet[open]::backdrop {
    animation: fade-in 0.3s ease-out;
  }
  .sheet[open] .sheet-card {
    animation: sheet-up 0.38s var(--ease-out);
  }
  .sheet.is-closing .sheet-card {
    animation: sheet-down 0.22s ease-in forwards;
  }
  .sheet.is-closing::backdrop {
    animation: fade-out 0.22s ease-in forwards;
  }

  .sheet-card {
    position: relative;
    display: flex;
    flex-direction: column;
    max-height: 92vh;
    max-height: calc(100dvh - 1rem - env(safe-area-inset-top));
    overflow-y: auto;
    overscroll-behavior: contain;
    border-radius: var(--radius-xl) var(--radius-xl) 0 0;
    background: var(--cream-50);
    box-shadow: var(--shadow-lg);
  }

  .sheet-media {
    flex: none;
    aspect-ratio: 16 / 10;
    max-height: 42vh;
    max-height: 42dvh;
    width: 100%;
    overflow: hidden;
    background: var(--cream-200);
  }
  .sheet-media :global(picture),
  .sheet-media :global(img) {
    width: 100%;
    height: 100%;
  }
  .sheet-media :global(img) {
    object-fit: cover;
  }

  .sheet-close {
    position: absolute;
    top: 0.75rem;
    right: 0.75rem;
    display: grid;
    place-items: center;
    width: 2.5rem;
    height: 2.5rem;
    border-radius: 50%;
    background: rgb(255 255 255 / 0.92);
    color: var(--ink-900);
    box-shadow: 0 2px 10px rgb(0 0 0 / 0.15);
  }

  .sheet-main {
    display: flex;
    flex-direction: column;
    min-height: 0;
  }
  .sheet-body {
    display: grid;
    gap: 0.75rem;
    padding: 1.3rem 1.25rem 0.5rem;
  }
  .sheet-kicker {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    color: var(--accent-700);
    font-size: 0.7rem;
    font-weight: 600;
    letter-spacing: 0.16em;
    text-transform: uppercase;
  }
  .sheet-title {
    font-family: var(--font-display);
    font-size: clamp(1.7rem, 1.4rem + 1.5vw, 2.3rem);
    font-weight: 560;
    line-height: 1.05;
    letter-spacing: -0.02em;
    color: var(--brand-800);
  }
  .sheet-lead {
    color: var(--ink-900);
    font-size: 1rem;
    font-weight: 500;
  }
  .sheet-text {
    color: var(--ink-700);
  }
  .sheet-block {
    display: grid;
    gap: 0.45rem;
    padding-top: 0.85rem;
    border-top: 1px solid var(--line);
  }
  .sheet-heading {
    color: var(--accent-700);
    font-size: 0.7rem;
    font-weight: 600;
    letter-spacing: 0.16em;
    text-transform: uppercase;
  }
  .sheet-small {
    color: var(--ink-500);
    font-size: 0.88rem;
  }

  .price-list li {
    display: flex;
    align-items: baseline;
    gap: 0.5rem;
    padding: 0.35rem 0;
  }
  .price-name {
    font-weight: 500;
  }
  .price-dots {
    flex: 1;
    min-width: 1rem;
    border-bottom: 1px dotted var(--line-strong);
    transform: translateY(-0.25rem);
  }
  .price-list .price {
    color: var(--brand-800);
    font-size: 1rem;
  }
  .price-list--compact li {
    padding: 0.18rem 0;
    font-size: 0.93rem;
  }
  .price-list--compact .price-name {
    font-weight: 500;
  }
  .price-list--compact .price {
    font-size: 0.95rem;
  }

  .ingredients {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
  }
  .ingredients li {
    padding: 0.2rem 0.6rem;
    border-radius: var(--radius-pill);
    box-shadow: inset 0 0 0 1px var(--line-strong);
    color: var(--ink-700);
    font-size: 0.82rem;
    font-weight: 500;
  }

  .sheet-note {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.6rem 0.8rem;
    border-radius: var(--radius);
    background: var(--cream-200);
    color: var(--ink-700);
    font-size: 0.88rem;
    font-weight: 500;
  }
  .sheet-note :global(svg) {
    flex: none;
  }

  .sheet-actions {
    position: sticky;
    bottom: 0;
    padding: 1rem 1.25rem calc(1rem + env(safe-area-inset-bottom));
    background: linear-gradient(rgb(255 253 249 / 0), var(--cream-50) 35%);
  }
  .sheet-actions .btn {
    width: 100%;
  }

  @media (min-width: 56rem) {
    .sheet {
      width: min(54rem, calc(100% - 3rem));
      margin: auto;
    }
    .sheet[open] .sheet-card {
      animation-name: pop-in;
    }
    .sheet.is-closing .sheet-card {
      animation-name: pop-out;
    }
    .sheet-card {
      display: grid;
      grid-template-columns: minmax(0, 1fr) minmax(0, 1.12fr);
      height: min(38rem, calc(100dvh - 4rem));
      max-height: none;
      overflow: hidden;
      border-radius: var(--radius-xl);
    }
    .sheet-media {
      aspect-ratio: auto;
      height: 100%;
      max-height: none;
    }
    .sheet-main {
      overflow-y: auto;
      overscroll-behavior: contain;
    }
    .sheet-body {
      padding: 2rem 2rem 0.5rem;
    }
    .sheet-actions {
      padding: 1rem 2rem 1.5rem;
    }
  }

  @keyframes sheet-up {
    from {
      transform: translateY(100%);
    }
  }
  @keyframes sheet-down {
    to {
      transform: translateY(100%);
    }
  }
  @keyframes pop-in {
    from {
      opacity: 0;
      transform: translateY(16px) scale(0.97);
    }
  }
  @keyframes pop-out {
    to {
      opacity: 0;
      transform: translateY(12px) scale(0.98);
    }
  }
  @keyframes fade-in {
    from {
      opacity: 0;
    }
  }
  @keyframes fade-out {
    to {
      opacity: 0;
    }
  }
</style>
