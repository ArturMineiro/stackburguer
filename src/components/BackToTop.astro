---
import Icon from './Icon.astro';
---

<a class="to-top" href="#topo" data-back-to-top>
  <Icon name="arrow-up" size={22} />
  <span class="visually-hidden">Voltar ao topo</span>
</a>

<style>
  .to-top {
    position: fixed;
    right: max(1rem, env(safe-area-inset-right));
    bottom: max(1rem, env(safe-area-inset-bottom));
    z-index: 30;
    display: grid;
    place-items: center;
    width: 3.25rem;
    height: 3.25rem;
    border-radius: 50%;
    background: var(--accent-600);
    color: var(--ink-900);
    box-shadow: 0 12px 28px rgb(0 0 0 / 0.28);
    opacity: 0;
    pointer-events: none;
    transform: translateY(12px) scale(0.9);
    transition:
      opacity 0.25s,
      transform 0.25s var(--ease-out);
  }
  .to-top:global(.is-visible) {
    opacity: 1;
    pointer-events: auto;
    transform: none;
  }
</style>
