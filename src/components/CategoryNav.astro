---
import Logo from '../assets/brand/logo.svg';
import Icon from './Icon.astro';
import { DOWNLOADS, SITE } from '../config/site.ts';
import { cardapio } from '../data/menu.ts';
---

<nav class="catnav" aria-label="Categorias do cardápio">
  <div class="catnav-inner container">
    <a class="catnav-brand" href="#topo">
      <Logo width={28} height={28} aria-hidden="true" />
      <span>{SITE.name}</span>
    </a>

    <ul class="catnav-list" role="list" data-nav-list>
      {cardapio.categorias.map((categoria) => (
        <li>
          <a class="tab" href={`#${categoria.id}`} data-nav-link={categoria.id}>
            <Icon name={categoria.icone} size={16} />
            <span>{categoria.titulo}</span>
          </a>
        </li>
      ))}
    </ul>

    <a class="catnav-pdf" href={DOWNLOADS.menuPdf.path} download={DOWNLOADS.menuPdf.filename}>
      <Icon name="download" size={16} />
      <span class="visually-hidden">Baixar cardápio em</span> PDF
    </a>
  </div>
</nav>

<style>
  .catnav {
    position: sticky;
    top: 0;
    z-index: 40;
    background: rgb(251 247 240 / 0.97);
    border-bottom: 1px solid var(--line);
  }
  @supports (backdrop-filter: blur(1px)) {
    .catnav {
      background: rgb(251 247 240 / 0.85);
      backdrop-filter: saturate(1.6) blur(14px);
    }
  }
  .catnav-inner {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    min-height: var(--nav-h);
    padding-top: env(safe-area-inset-top, 0);
  }

  .catnav-brand {
    display: none;
    align-items: center;
    gap: 0.55rem;
    flex: none;
    color: var(--brand-800);
    font-family: var(--font-display);
    font-size: 1.2rem;
    font-weight: 600;
    letter-spacing: -0.01em;
    text-decoration: none;
  }

  .catnav-list {
    display: flex;
    gap: 0.25rem;
    flex: 1;
    min-width: 0;
    overflow-x: auto;
    margin-left: -0.6rem;
    scroll-snap-type: x proximity;
    scrollbar-width: none;
    -webkit-overflow-scrolling: touch;
    mask-image: linear-gradient(90deg, transparent 0, #000 0.6rem, #000 calc(100% - 1.6rem), transparent 100%);
  }
  .catnav-list::-webkit-scrollbar {
    display: none;
  }
  .catnav-list li {
    flex: none;
    scroll-snap-align: start;
  }

  /* Abas de texto; a atual ganha um sublinhado fino na cor de destaque. */
  .tab {
    position: relative;
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    min-height: var(--nav-h);
    padding: 0 0.6rem;
    color: var(--ink-500);
    font-size: 0.92rem;
    font-weight: 500;
    text-decoration: none;
    white-space: nowrap;
    transition: color 0.2s;
  }
  .tab::after {
    content: '';
    position: absolute;
    left: 0.6rem;
    right: 0.6rem;
    bottom: 0;
    height: 2px;
    border-radius: 2px;
    background: var(--accent-600);
    transform: scaleX(0);
    transition: transform 0.25s var(--ease-out);
  }
  .tab:hover {
    color: var(--ink-900);
  }
  .tab[aria-current='true'] {
    color: var(--brand-800);
    font-weight: 600;
  }
  .tab[aria-current='true']::after {
    transform: scaleX(1);
  }
  .tab[aria-current='true'] :global(svg) {
    color: var(--accent-600);
  }
  .tab[data-empty] {
    opacity: 0.4;
  }

  .catnav-pdf {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    flex: none;
    min-height: 2.75rem;
    padding: 0 0.85rem;
    border-radius: var(--radius-pill);
    color: var(--brand-700);
    font-size: 0.85rem;
    font-weight: 600;
    text-decoration: none;
    box-shadow: inset 0 0 0 1px var(--line-strong);
    transition:
      background-color 0.2s,
      box-shadow 0.2s;
  }
  .catnav-pdf:hover {
    background: #fff;
    box-shadow: inset 0 0 0 1px var(--brand-400);
  }

  @media (min-width: 64rem) {
    .catnav-inner {
      gap: 1.5rem;
    }
    .catnav-brand {
      display: inline-flex;
    }
    .catnav-list {
      justify-content: center;
      margin-left: 0;
      mask-image: none;
    }
  }
</style>
