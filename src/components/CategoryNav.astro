---
import Logo from '../assets/brand/logo.svg';
import Icon from './Icon.astro';
import { DOWNLOADS, SITE } from '../config/site.ts';
import { cardapio } from '../data/menu.ts';
---

<nav class="catnav" aria-label="Categorias do cardápio">
  <div class="catnav-inner container">
    <a class="catnav-brand" href="#topo">
      <Logo width={34} height={34} aria-hidden="true" />
      <span>{SITE.name}</span>
    </a>

    <ul class="catnav-list" role="list" data-nav-list>
      {cardapio.categorias.map((categoria) => (
        <li>
          <a class="chip" href={`#${categoria.id}`} data-nav-link={categoria.id}>
            <Icon name={categoria.icone} size={18} />
            <span>{categoria.titulo}</span>
          </a>
        </li>
      ))}
    </ul>

    <a class="catnav-pdf" href={DOWNLOADS.menuPdf.path} download={DOWNLOADS.menuPdf.filename}>
      <Icon name="download" size={18} />
      <span class="visually-hidden">Baixar cardápio em</span> PDF
    </a>
  </div>
</nav>

<style>
  .catnav {
    position: sticky;
    top: 0;
    z-index: 40;
    background: rgb(16 41 31 / 0.96);
    border-bottom: 1px solid rgb(255 255 255 / 0.08);
    box-shadow: 0 10px 30px rgb(11 33 26 / 0.18);
  }
  @supports (backdrop-filter: blur(1px)) {
    .catnav {
      background: rgb(16 41 31 / 0.88);
      backdrop-filter: saturate(1.4) blur(14px);
    }
  }
  .catnav-inner {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    min-height: var(--nav-h);
    padding-top: env(safe-area-inset-top, 0);
  }

  .catnav-brand {
    display: none;
    align-items: center;
    gap: 0.6rem;
    flex: none;
    color: #fff;
    font-family: var(--font-display);
    font-size: 1.55rem;
    letter-spacing: 0.03em;
    text-decoration: none;
  }

  .catnav-list {
    display: flex;
    gap: 0.4rem;
    flex: 1;
    min-width: 0;
    overflow-x: auto;
    padding: 0.55rem 0.25rem;
    margin-left: -0.25rem;
    scroll-snap-type: x proximity;
    scrollbar-width: none;
    -webkit-overflow-scrolling: touch;
    mask-image: linear-gradient(90deg, transparent 0, #000 0.6rem, #000 calc(100% - 1.6rem), transparent 100%);
  }
  .catnav-list::-webkit-scrollbar {
    display: none;
  }
  .catnav-list li {
    flex: none;
    scroll-snap-align: start;
  }

  .chip {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    min-height: 2.75rem;
    padding: 0.5rem 0.95rem;
    border-radius: var(--radius-pill);
    color: rgb(255 255 255 / 0.86);
    background: rgb(255 255 255 / 0.07);
    box-shadow: inset 0 0 0 1px rgb(255 255 255 / 0.1);
    font-size: 0.95rem;
    font-weight: 650;
    text-decoration: none;
    white-space: nowrap;
    transition:
      background-color 0.2s,
      color 0.2s,
      box-shadow 0.2s;
  }
  .chip:hover {
    background: rgb(255 255 255 / 0.14);
    color: #fff;
  }
  .chip[aria-current='true'] {
    background: var(--accent-600);
    color: var(--ink-900);
    box-shadow: 0 6px 18px rgb(234 125 23 / 0.35);
  }
  .chip[data-empty] {
    opacity: 0.45;
  }

  .catnav-pdf {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    flex: none;
    min-height: 2.75rem;
    padding: 0.5rem 0.8rem;
    border-radius: var(--radius-pill);
    color: var(--accent-400);
    font-size: 0.9rem;
    font-weight: 800;
    text-decoration: none;
    box-shadow: inset 0 0 0 1.5px rgb(255 177 92 / 0.5);
  }
  .catnav-pdf:hover {
    background: rgb(255 177 92 / 0.12);
  }

  @media (min-width: 64rem) {
    .catnav-inner {
      gap: 1.5rem;
    }
    .catnav-brand {
      display: inline-flex;
    }
    .catnav-list {
      justify-content: center;
      mask-image: none;
    }
  }
</style>
